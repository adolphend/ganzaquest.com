# GanzaQuest – web server rules (Hostinger / Apache / LiteSpeed)

Options -Indexes
DirectoryIndex index.php
ServerSignature Off

<IfModule mod_rewrite.c>
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Send www to the main domain
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Block private folders and files
RewriteRule ^(app|\.git)(/|$) - [R=404,L,NC]
RewriteRule (^|/)\.(?!well-known/) - [R=404,L]
RewriteCond %{REQUEST_URI} !^/assets/data/(suspension-evidence|codex-house-evidence)\.json$
RewriteRule \.(md|lock|log|json|ini|sh|sql)$ - [R=404,L,NC]

# Hide PHP: only index.php may run, and never by name
RewriteCond %{THE_REQUEST} \s/+index\.php [NC]
RewriteRule ^ / [R=301,L]
RewriteCond %{REQUEST_URI} !^/index\.php$
RewriteRule \.php$ - [R=404,L,NC]

# Everything that is not a real file goes to index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
Header always unset X-Powered-By
Header unset X-Powered-By
<FilesMatch "\.(css|js|png|jpg|jpeg|svg|webp|woff2?)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
</IfModule>

ErrorDocument 404 /index.php
